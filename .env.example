# Copier vers .env (ignoré par git). Ne JAMAIS committer de vraies valeurs.
NODE_ENV=production

# Postgres (compose). Utiliser un mot de passe sans caractères spéciaux d'URL : openssl rand -hex 24
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio

# Auth : openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL publique du site (https://monsite.fr en production)
BETTER_AUTH_URL=http://localhost:3000

# Hors compose (dev local / scripts) :
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# SITE_DOMAIN=monsite.fr   (production uniquement, pour Caddy)
